# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worktrack
# or individual vars (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=worktrack
PGUSER=postgres
PGPASSWORD=postgres

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Ikorodu Local Government Secretariat coordinates
OFFICE_LATITUDE=6.6152
OFFICE_LONGITUDE=3.5073
OFFICE_RADIUS_METERS=200

# Work hours (24h format, "HH:mm")
WORK_START_TIME=08:00
LATE_CUTOFF_TIME=09:00
WORK_END_TIME=16:00
FULL_WORK_HOURS=8
